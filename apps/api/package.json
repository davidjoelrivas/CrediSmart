{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "description": "API del sistema: casos de uso, puertos y adaptadores",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "db:check": "tsx --env-file-if-exists=../../.env src/cli/db-check.ts",
    "db:backup": "tsx --env-file-if-exists=../../.env src/cli/backup.ts",
    "db:seed:demo": "tsx --env-file-if-exists=../../.env src/cli/seed-demo.ts",
    "keys:generate": "tsx src/cli/generate-keys.ts"
  },
  "dependencies": {
    "@app/domain": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
