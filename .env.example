# Copiá este archivo como .env y completá los valores. El archivo .env NUNCA se sube a Git.

# --- Base de datos (Supabase) ---
# En el panel de Supabase: botón "Conectar" -> "Session pooler" -> copiar la cadena de conexión.
# Podés dejar el texto [YOUR-PASSWORD] tal cual: la contraseña real va en DATABASE_PASSWORD.
DATABASE_URL=postgres://postgres.REFERENCIA:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
# La contraseña de la base, tal cual la creaste (con cualquier símbolo, sin codificar).
DATABASE_PASSWORD=
# Conexiones máximas abiertas (opcional; 5 por defecto)
# DATABASE_POOL_MAX=5
# Solo si usás ?sslmode=verify-full: certificado de la autoridad de Supabase (texto PEM)
# DATABASE_SSL_CA=

# --- Cifrado de datos sensibles (DNI de los clientes) ---
# Generalas con: pnpm --filter @app/api keys:generate   (cada entorno necesita sus propias llaves)
FIELD_ENCRYPTION_KEY=
FIELD_HASH_KEY=

# --- Servidor (producción) ---
# Dirección pública del sistema: la que lleva el QR de los recibos. En producción debe empezar con https://
PUBLIC_BASE_URL=http://localhost:3000
# Puerto donde escucha (las plataformas como Render o Railway lo definen solas)
# PORT=3000
# NODE_ENV=production   (activa cookies seguras, HSTS y registros en formato JSON)
# Carpeta de la aplicación web compilada (por defecto ../web/dist)
# WEB_DIST=../web/dist
# Orígenes extra permitidos para escribir datos, separados por coma (solo en desarrollo con Vite)
# ALLOWED_ORIGINS=http://localhost:5173
# Intentos de inicio de sesión por minuto y por IP / solicitudes globales por minuto
# LOGIN_RATE_LIMIT=10
# GLOBAL_RATE_LIMIT=300

# --- Usuarios (solo para los comandos de línea) ---
# Contraseña de los usuarios de la demo (si no la defines, se genera una y se muestra una vez)
# DEMO_PASSWORD=
# Contraseña de users:create y users:reset-password (si no la defines, se genera una)
# USER_PASSWORD=

# --- Respaldos (opcional) ---
# Ruta de pg_dump si no está en el PATH de tu computadora
# PG_DUMP_PATH=C:\ruta\a\pgsql\bin\pg_dump.exe

# --- Pruebas de integración: SOLO un PostgreSQL local, nunca la base de producción ---
# POSTGRES_ADMIN_URL=postgres://postgres@127.0.0.1:5432/postgres
