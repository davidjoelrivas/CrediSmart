{
  "name": "prestamos-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Sistema de gestión de préstamos para prestamistas independientes",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @app/api dev",
    "dev:web": "pnpm --filter @app/web dev",
    "build": "pnpm --filter @app/web build",
    "start": "pnpm --filter @app/api start",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.2"
  }
}
